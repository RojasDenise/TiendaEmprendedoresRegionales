# Copiá este archivo como .env y completá los valores reales.
# El .env NUNCA se sube al repo (está en .gitignore).

# Base de datos (PostgreSQL). Una sola variable con la URL de conexión.
# - Neon: copiar la "Connection string" del panel (termina en ?sslmode=require).
#   Si en la consola aparece un aviso largo sobre "SSL modes", es inofensivo;
#   se quita cambiando sslmode=require por sslmode=verify-full en la URL.
# - Postgres local: postgresql://usuario:contraseña@localhost:5432/tienda
DATABASE_URL=postgresql://usuario:contraseña@host/base?sslmode=require

# Imágenes (Cloudinary). Los tres valores están en el dashboard de Cloudinary.
# Si se dejan vacíos, las imágenes se guardan en backend/public/uploads (solo sirve en local).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Servidor
PORT=5000
NODE_ENV=development

# URL del frontend (para CORS). Si hay varias, separalas con coma.
FRONTEND_URL=http://localhost:5173






